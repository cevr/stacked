{
  "name": "@cvr/stacked",
  "version": "0.10.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/cevr/stacked"
  },
  "bin": {
    "stacked": "./bin/stacked"
  },
  "files": [
    "src",
    "scripts",
    "skills",
    "tsconfig.json"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun run scripts/build.ts",
    "link": "bun run build",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test",
    "bench:detect": "bun run scripts/benchmark-detect.ts",
    "gate": "concurrently -n type,lint,fmt,test,build -c blue,yellow,magenta,green,cyan \"bun run typecheck\" \"bun run lint\" \"bun run fmt\" \"bun run test\" \"bun run build\"",
    "version": "changeset version",
    "release": "changeset publish",
    "postinstall": "bun run build",
    "prepare": "lefthook install && effect-tsgo patch"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.98",
    "effect": "4.0.0-beta.98",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@effect/tsgo": "^0.23.0",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "concurrently": "^10.0.3",
    "effect-bun-test": "^0.3.0",
    "fast-check": "^4.9.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-plugin-effect": "^0.2.3",
    "typescript": "^7.0.2"
  }
}
